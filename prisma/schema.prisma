generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  avatar    String?
  role      String     @default("USER")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wallet    Wallet?
  policies  Policy[]
  agents    Agent[]
  auditLogs AuditLog[]
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  address      String        @unique
  balance      Float         @default(50000.0)
  currency     String        @default("TRY")
  isFrozen     Boolean       @default(false)
  network      String        @default("AgentPay Sandbox L2 (MPC-AA)")
  nonce        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Agent {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  role         String        @default("Procurement & Commerce Agent")
  permissions  String        @default("[\"search_products\",\"compare_products\",\"check_budget\",\"check_policy\",\"create_payment_request\",\"request_user_approval\",\"execute_payment\"]")
  isActive     Boolean       @default(true)
  avatar       String?
  lastActiveAt DateTime      @default(now())
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  auditLogs    AuditLog[]
}

model Policy {
  id                               String   @id @default(uuid())
  userId                           String
  user                             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                             String   @default("Default Spending Policy")
  dailyLimit                       Float    @default(2500.0)
  singleLimit                      Float    @default(1000.0)
  monthlyLimit                     Float    @default(10000.0)
  approvalThreshold                Float    @default(1000.0)
  allowedCategories                String   @default("[\"Electronics\",\"Education\",\"Software\",\"Office Equipment\",\"Books\"]")
  blockedCategories                String   @default("[\"Gambling\",\"Unknown\",\"High Risk\",\"Crypto Scams\",\"Adult\"]")
  allowedMerchants                 String   @default("[\"TechStore Demo\",\"StudentTech\",\"Campus Market\",\"Teknosa\",\"Amazon\",\"Trendyol\"]")
  blockedMerchants                 String   @default("[\"DarkShop Demo\",\"Rogue Address 0x999\",\"Untrusted Crypto Gateway\"]")
  requireApprovalForUnknownMerchant Boolean  @default(true)
  autoFreezeOnRiskThreshold        Float    @default(80.0)
  isStrict                         Boolean  @default(true)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}

model Merchant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  domain       String
  trustScore   Int           @default(95)
  isVerified   Boolean       @default(true)
  isBlocked    Boolean       @default(false)
  category     String
  address      String?
  createdAt    DateTime      @default(now())
  products     Product[]
  transactions Transaction[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  category    String
  price       Float
  currency    String   @default("TRY")
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ram         String?
  storage     String?
  cpu         String?
  score       Float    @default(9.2)
  stock       Int      @default(10)
  imageUrl    String?
  specs       String?
  createdAt   DateTime @default(now())
}

model Transaction {
  id                String     @id @default(uuid())
  walletId          String
  wallet            Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  agentId           String?
  agent             Agent?     @relation(fields: [agentId], references: [id])
  merchantId        String?
  merchant          Merchant?  @relation(fields: [merchantId], references: [id])
  merchantName      String
  amount            Float
  currency          String     @default("TRY")
  category          String
  description       String
  status            String     @default("PENDING") // PENDING, APPROVAL_REQUIRED, APPROVED, REJECTED, COMPLETED, FAILED
  riskScore         Int        @default(15) // 0-100
  riskLevel         String     @default("LOW") // LOW, MEDIUM, HIGH
  policyEvaluation  String?    // JSON string breakdown
  mpcShares         String?    // JSON string breakdown {"aiShare": true, "policyShare": true, "userShare": false, "threshold": 2, "total": 3}
  signatureHash     String?
  txHash            String?
  blockNumber       Int?
  executionTimeline String?    // JSON array of lifecycle steps
  failureReason     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  approval          Approval?
  auditLogs         AuditLog[]
}

model Approval {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  status        String      @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt   DateTime    @default(now())
  resolvedAt    DateTime?
  reason        String
  notes         String?
  approverName  String      @default("Melike Demo User")
}

model AuditLog {
  id            String       @id @default(uuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  agentId       String?
  agent         Agent?       @relation(fields: [agentId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  action        String
  toolName      String?
  inputData     String?
  outputData    String?
  status        String       @default("SUCCESS") // SUCCESS, WARNING, ERROR, BLOCKED
  ipAddress     String       @default("127.0.0.1 (Sandbox Session)")
  timestamp     DateTime     @default(now())
  previousHash  String?      // Reference to prior block in hash chain
  hash          String       // Simulated immutable SHA-256 chain hash
}

